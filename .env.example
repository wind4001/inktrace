# ==================== 复制本文件为 .env 后填写 ====================
#   cp .env.example .env      (Windows: copy .env.example .env)
# .env 已被 .gitignore 排除, 不会提交到 git

# -------------------- 大语言模型 (必填) --------------------
# 本程序通过 OpenAI 兼容协议调用大模型, 任何提供该协议的服务都能用。
# 把 LLM_API_KEY / LLM_BASE_URL / LLM_MODEL 三行按你选的服务填好即可。
#
# 常用服务商对照表 (2026-10 核实, model id 以各家官方文档为准):
#   DeepSeek      LLM_BASE_URL=https://api.deepseek.com
#                 LLM_MODEL=deepseek-v4-flash      (便宜快速, 推荐)
#                 LLM_MODEL=deepseek-v4-pro        (推理更强, 更贵)
#   通义千问(百炼) LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#                 LLM_MODEL=qwen-plus
#   Kimi(Moonshot) LLM_BASE_URL=https://api.moonshot.cn/v1
#                 LLM_MODEL=moonshot-v1-8k
#   智谱 GLM       LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#                 LLM_MODEL=glm-4-plus
#   OpenAI        LLM_BASE_URL=https://api.openai.com/v1
#                 LLM_MODEL=gpt-4o-mini
#   本地 Ollama    LLM_BASE_URL=http://127.0.0.1:11434/v1
#                 LLM_MODEL=qwen2.5:14b            (LLM_API_KEY 随便填, 如 ollama)
#
# 注意: 模型需具备较好的指令遵循与 JSON 输出能力, 否则解析会不稳定。
LLM_API_KEY=sk-在这里填入你的Key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=

# -------------------- OCR 模型 (可选, 留空即用代码默认值) --------------------
# 默认 PP-OCRv6 medium (34.5M 参数; 相比 v5: det +4.6%, rec +5.1%)
# 若你的环境拉不到 v6, 回退 PP-OCRv5 server:
#   OCR_DET_MODEL=PP-OCRv5_server_det
#   OCR_REC_MODEL=PP-OCRv5_server_rec
OCR_DET_MODEL=PP-OCRv6_medium_det
OCR_REC_MODEL=PP-OCRv6_medium_rec
